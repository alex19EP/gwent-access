<Project Sdk="Microsoft.NET.Sdk">
  <!-- The HOST: the BepInEx plugin (GwentAccess.dll). Only src/Host and src/Dev compile here; everything else is the
       reloadable module (module/GwentAccess.Module.csproj). The game keeps this dll open, so changing it means
       closing the game; module changes hot-reload (just reload). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GwentAccess</AssemblyName>
    <RootNamespace>GwentAccess</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="GameReferences.props" />
  <ItemGroup>
    <Compile Include="Host\**\*.cs;Dev\**\*.cs" />
  </ItemGroup>
  <!-- Debug builds carry the dev server (src/Dev): Roslyn powers its C# eval. Pinned to 4.0.x because newer
       Roslyn needs System.Collections.Immutable 7+, and the .NET 6 runtime BepInEx ships has 6.0. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>
  <!-- dotnet build -p:Deploy=true copies the host (and in Debug, Roslyn) into the game's plugin folder.
       Building the module with -p:Deploy=true builds and deploys this too. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)GwentAccess.dll;$(OutDir)GwentAccess.pdb;$(OutDir)Microsoft.CodeAnalysis*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginDeployDir)" />
  </Target>
</Project>
