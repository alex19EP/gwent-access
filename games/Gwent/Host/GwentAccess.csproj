<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gwent Access, the host (GwentAccess.dll). The build lives in build/Host.props; the plugin's identity in
       GameInfo.cs. The module is ../Module/GwentAccess.Module.csproj. -->
  <PropertyGroup>
    <ModName>GwentAccess</ModName>
    <GameDirEnvVar>GWENT_DIR</GameDirEnvVar>
    <DefaultGameDir>C:\Program Files (x86)\Steam\steamapps\common\GWENT The Witcher Card Game</DefaultGameDir>
  </PropertyGroup>
  <Import Project="..\..\..\build\Host.props" />
</Project>
