<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gwent Access, the module: src/Access.Core, src/Shared and every .cs in this folder. The build lives in
       build/Module.props. Building this builds the host (../Host) too. -->
  <PropertyGroup>
    <ModName>GwentAccess</ModName>
    <GameDefine>GWENT</GameDefine>
    <GameDirEnvVar>GWENT_DIR</GameDirEnvVar>
    <DefaultGameDir>C:\Program Files (x86)\Steam\steamapps\common\GWENT The Witcher Card Game</DefaultGameDir>
  </PropertyGroup>
  <Import Project="..\..\..\build\Module.props" />
</Project>
