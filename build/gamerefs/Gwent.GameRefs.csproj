<!-- Container project that packs JetBrains Refasmer-stripped game reference assemblies into a NuGet package for
     CI. It has no source and produces no assembly of its own: BepInEx/ is generated by
     scripts/build-gamerefs.ps1 (git-ignored) and carried verbatim into the package.

     The package mirrors the game folder (BepInEx\core, BepInEx\interop), so CI builds with
     -p:GwentDir=<package folder> and GameReferences.props needs no CI-specific paths. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: no lib/ or dependencies, intentional: this is a bag of reference DLLs.
         NU5100: DLLs live outside lib/ so NuGet won't auto-reference them, which is what we want;
         GameReferences.props references them by path through GwentDir. -->
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>

    <PackageId>Gwent.GameRefs</PackageId>
    <!-- Overridden by build-gamerefs.ps1 (-p:Version=...). -->
    <Version>0.0.0</Version>
    <Authors>alex19EP</Authors>
    <Description>Reference (metadata-only) assemblies for Gwent: The Witcher Card Game under BepInEx 6 be.790 IL2CPP, generated with JetBrains Refasmer (method bodies stripped). Build-time-only dependency for compiling and packaging the Gwent Access accessibility mod in CI. Contains no game logic or resources.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alex19EP/gwent-access</RepositoryUrl>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>
  <ItemGroup>
    <None Include="BepInEx\core\*.dll" Pack="true" PackagePath="BepInEx\core\" />
    <None Include="BepInEx\interop\*.dll" Pack="true" PackagePath="BepInEx\interop\" />
  </ItemGroup>
</Project>
